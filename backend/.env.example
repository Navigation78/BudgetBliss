# Copy to .env and fill in real values. Never commit the real .env file.
#
# serverless.yml injects STAGE/REGION/*_TABLE automatically when you deploy or run
# `serverless offline`, so you don't need to set those here for local dev. The vars
# below are the ones serverless.yml reads from your shell/`.env` via ${env:...}, plus
# what validateEnv.js and local (non-Lambda) scripts need.

# --- Core AWS ---
# Matches serverless.yml's provider.region default. Required by scripts run outside
# serverless-offline (e.g. `npm run validate:env`), since AWS_REGION is only
# auto-provided once code is actually running inside a deployed Lambda.
AWS_REGION=us-east-1
STAGE=dev

# Only needed for local scripts/tests if you're not using an AWS CLI profile or IAM role.
# Never required (and never used) once deployed to Lambda - the execution role handles it.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Cognito ---
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-app-client-id

# --- M-PESA (Safaricom Daraja API) ---
MPESA_API_KEY=your-mpesa-api-key
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret

# --- OpenAI (transaction categorization / daily tips) ---
OPENAI_API_KEY=your-openai-api-key

# --- SNS topics / S3 / EventBridge (optional) ---
# serverless.yml already defaults these using your AWS account id at deploy time
# (see resources.Resources and the ${aws:accountId} variable). Only set these if you
# want to point at pre-existing resources instead of the ones serverless.yml creates.
# SNS_NOTIFICATIONS_TOPIC=
# SNS_DAILY_TIPS_TOPIC=
# SNS_BUDGET_ALERTS_TOPIC=
# SNS_TRANSACTION_ERRORS_TOPIC=
# LAMBDA_CODE_BUCKET=
# EVENT_BUS_NAME=

# --- Local dev only ---
# Lets you bypass real Cognito token verification during local testing by sending
# an `x-dev-user` header or `Authorization: Bearer dev:<userId>` instead of a real
# JWT. NEVER set this in a deployed stage (dev/prod) - see middleware/auth.js.
# DEV_AUTH_BYPASS=true
