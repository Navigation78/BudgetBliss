{
  "name": "budgetbliss-backend",
  "version": "1.0.0",
  "description": "Serverless backend for BudgetBliss - AWS Lambda, DynamoDB, and EventBridge",
  "main": "handler.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "dev": "serverless offline start",
    "offline": "serverless offline start --httpPort 3000",
    "validate:env": "node ./backend/scripts/validateEnv.js",
    "test": "jest",
    "logs": "serverless logs -f",
    "invoke": "serverless invoke -f"
  },
  "dependencies": {
    "aws-sdk": "^2.1.x",
    "uuid": "^9.0.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "serverless": "^3.36.0",
    "serverless-offline": "^12.0.4",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-plugin-tracing": "^2.2.0",
    "jest": "^29.7.0",
    "webpack": "^5.89.0",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3"
  },
  "keywords": ["serverless", "aws", "lambda", "dynamodb", "budgetbliss"],
  "author": "Navigation78",
  "license": "MIT"
}
