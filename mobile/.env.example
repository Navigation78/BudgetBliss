# Copy to .env and adjust as needed. Never commit the real .env file.
# Expo inlines any EXPO_PUBLIC_-prefixed var into the JS bundle at build time.

# Base URL of the backend API.
# - Local `serverless-offline` (npm run dev inside backend/): use your machine's
#   LAN IP, not localhost - a device/emulator can't reach the host's localhost.
#   e.g. http://192.168.1.20:3000/dev
# - Deployed backend: use the real API Gateway URL from `serverless deploy`.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/dev
