# Copy to .env and adjust as needed. Never commit the real .env file.

# Base URL of the backend API.
# - Running the backend locally with `npm run dev` (serverless-offline) inside backend/:
#   endpoints are served under a /dev stage prefix, e.g. http://localhost:3000/dev
# - Pointing at a deployed backend: use the real API Gateway URL from `serverless deploy`.
VITE_API_URL=http://localhost:3000/dev
